<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Cleartext is permitted ONLY to the local development backend, reached
         at 10.0.2.2 from the emulator or via `adb reverse` from a phone.
         Everything else stays HTTPS-only, so shipping this build cannot
         silently downgrade a real deployment. -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">10.0.2.2</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">localhost</domain>
    </domain-config>
    <base-config cleartextTrafficPermitted="false" />
</network-security-config>
