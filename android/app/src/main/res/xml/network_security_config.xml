<?xml version="1.0" encoding="utf-8"?>
<!--
  RELEASE POLICY: HTTPS only.

  Loopback is allowed because a device tethered over `adb reverse` reaches the
  development backend at 127.0.0.1, and because loopback traffic never leaves
  the handset. Everything else must be encrypted: patient data must not travel
  over plain HTTP on a real deployment.

  Debug builds override this with a permissive config - see
  src/debug/res/xml/network_security_config.xml.
-->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">localhost</domain>
    </domain-config>
    <base-config cleartextTrafficPermitted="false" />
</network-security-config>
