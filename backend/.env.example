# Copy this file to .env and fill in real values as you get them.
# Everything works with mocks/defaults out of the box for local demo use.

ENVIRONMENT=development
DATABASE_URL=sqlite:///./data/sevakai.db

JWT_SECRET=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=720

# --- LLM (agents) ---
# LLM_PROVIDER=mock uses canned/rule-based responses so the pipeline runs with zero cost/setup.
# Set to "gemini" and add a free-tier key from https://aistudio.google.com/apikey to go live.
LLM_PROVIDER=mock
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# --- Speech-to-text ---
# STT_PROVIDER=mock accepts a transcript directly from the client (e.g. browser Web Speech API)
# or returns a canned transcript for uploaded audio. Set to "bhashini" once you have credentials.
STT_PROVIDER=mock
BHASHINI_API_KEY=
BHASHINI_USER_ID=

# --- WhatsApp ---
# WHATSAPP_PROVIDER=mock just stores the drafted message in the DB / shows it in the UI.
WHATSAPP_PROVIDER=mock
WHATSAPP_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

CHROMA_PERSIST_DIR=./data/chroma
HIGH_RISK_ALERT_SECONDS=60
ESCALATION_THRESHOLD_HOURS=48
