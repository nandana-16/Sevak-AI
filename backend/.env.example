# Copy to .env and fill in. Everything runs with mocks out of the box.
ENVIRONMENT=development
DATABASE_URL=sqlite:///./data/sevakai.db

JWT_SECRET=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
# Long-lived: field workers go days without connectivity.
JWT_EXPIRE_MINUTES=20160

# --- LLM -------------------------------------------------------------------
# groq | mock.  Free key: https://console.groq.com/keys
LLM_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# --- Speech-to-text --------------------------------------------------------
# Online capture uses Android's on-device SpeechRecognizer and posts text.
# Audio queued while offline is transcribed here.
#   bhashini      Government of India platform (ai4bharat). Best provenance for
#                 an NHM-facing system; audio stays in government infra.
#                 Falls back to groq_whisper automatically if unreachable.
#   groq_whisper  whisper-large-v3. Accepts the app's audio without conversion.
#   whisper       faster-whisper, fully local.
#   mock          canned transcript, no setup needed.
STT_PROVIDER=bhashini
WHISPER_MODEL=whisper-large-v3

# Register at https://bhashini.gov.in to get these. The pipeline id below is
# MeitY's public one and normally needs no change.
BHASHINI_USER_ID=
BHASHINI_API_KEY=
BHASHINI_PIPELINE_ID=64392f96daac500b55c543cd

# --- Aadhaar ---------------------------------------------------------------
# Salt for the one-way hash. Never store raw Aadhaar numbers.
AADHAAR_HASH_SALT=change-me-too

CHROMA_PERSIST_DIR=./data/chroma
GUIDELINES_DIR=./data/guidelines
AUDIO_DIR=./data/audio
